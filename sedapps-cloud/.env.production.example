# Copy this file to .env on the server. Do not commit the resulting .env file.
APP_ENV=production
LOG_LEVEL=INFO

POSTGRES_USER=sedapps
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
POSTGRES_DB=sedapps
DATABASE_URL=postgresql+psycopg://sedapps:REPLACE_WITH_A_LONG_RANDOM_PASSWORD@postgres:5432/sedapps
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Generate independently with: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
INTERNAL_API_TOKEN=REPLACE_WITH_A_LONG_RANDOM_SECRET
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# Chariow: keep both values server-side. Never expose the API key to Flutter.
CHARIOW_API_URL=https://api.chariow.com/v1
CHARIOW_API_KEY=REPLACE_WITH_YOUR_CHARIOW_API_KEY
CHARIOW_PULSE_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
CHARIOW_BILLING_EMAIL_DOMAIN=billing.salaai.site

# Branded payment receipts sent to the user's real account email.
RESEND_API_KEY=REPLACE_WITH_YOUR_RESEND_API_KEY
RESEND_FROM_EMAIL=Sala AI <factures@email.salaai.site>
SALAAI_INVOICE_LOGO_URL=https://app.salaai.site/icons/Icon-192.png
SALAAI_LEGAL_NAME=Sala AI
SALAAI_LEGAL_ADDRESS=REPLACE_WITH_YOUR_LEGAL_BILLING_ADDRESS
SALAAI_TAX_ID=REPLACE_WITH_YOUR_TAX_OR_COMPANY_ID

# Firebase Hosting origin. Add a custom frontend domain here when it is configured.
CORS_ORIGINS=https://sedapps.web.app,https://app.salaai.site
INBOX_ALLOWED_ORIGINS=https://sedapps.web.app,https://app.salaai.site
ANALYTICS_RESPECT_DNT=true

AI_ORCHESTRATOR_URL=http://ai-orchestrator:8001
DEPLOY_SERVICE_URL=http://deploy-service:8002
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=REPLACE_WITH_YOUR_PROVIDER_KEY

# Configure these when custom-domain publishing is enabled.
DEPLOY_DRY_RUN=true
DEPLOY_BASE_DOMAIN=salaai.site
DEPLOY_PUBLIC_BASE_URL=https://salaai.site
OVH_ZONE_NAME=salaai.site
